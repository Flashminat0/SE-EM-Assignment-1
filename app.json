{
  "expo": {
    "name": "Edu-Alarm",
    "slug": "edu-alarm",
    "owner": "flashminat0",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "edualarm",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "com.sliitapp.edualarm",
      "infoPlist": {
        "NSCameraUsageDescription": "Edu-Alarm uses the camera to photograph assignment briefs and whiteboards.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#2E63D9",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": ["android.permission.SCHEDULE_EXACT_ALARM", "android.permission.USE_EXACT_ALARM"],
      "package": "com.sliitapp.edualarm"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#2E63D9",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96
        }
      ],
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#2E63D9"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Edu-Alarm uses the camera to photograph assignment briefs and whiteboards."
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "2044cf2e-bfe3-405a-aad2-0be6ca514a0a"
      }
    }
  }
}
